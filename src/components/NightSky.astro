---
// The night sky: pixel stars at random places, each twinkling on its own rhythm, with a few cross-shaped
// stars that flash now and then. By default it fills the element it sits in (the main page's top section);
// with `fixed` it fills the window behind the whole page.
interface Props {
  fixed?: boolean;
}
const { fixed = false } = Astro.props;
---
<canvas class:list={['sky', { fixed }]} aria-hidden="true"></canvas>

<script>
  type Star = { x: number; y: number; size: number; color: string; base: number; peak: number; period: number; phase: number; cross: boolean; flashAt: number };
  const colors = ['255,255,255', '255,255,255', '255,255,255', '242,227,166', '207,230,255'];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Each page's skies start when the page loads and stop before the client-side router swaps the page.
  const stoppers: (() => void)[] = [];
  const startSky = (canvas: HTMLCanvasElement) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    let stars: Star[] = [];
    let unit = 1;

    const setup = () => {
      const dpr = window.devicePixelRatio || 1;
      unit = Math.max(1, Math.round(dpr));
      const w = canvas.clientWidth, h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      const count = Math.min(320, Math.round((w * h) / 7000));
      const cols = Math.floor(canvas.width / unit), rows = Math.floor(canvas.height / unit);
      stars = Array.from({ length: count }, () => {
        const r = Math.random();
        return {
          x: Math.floor(Math.random() * cols) * unit,
          y: Math.floor(Math.random() * rows) * unit,
          size: r < 0.72 ? 1 : 2,
          color: colors[Math.floor(Math.random() * colors.length)],
          base: 0.15 + Math.random() * 0.35,
          peak: 0.7 + Math.random() * 0.3,
          period: 2 + Math.random() * 5,
          phase: Math.random() * Math.PI * 2,
          cross: r > 0.95,
          flashAt: Math.random() * 12,
        };
      });
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const s of stars) {
        const glow = 0.5 + 0.5 * Math.sin((time * Math.PI * 2) / s.period + s.phase);
        const alpha = s.base + (s.peak - s.base) * glow;
        if (s.cross) {
          // a cross-shaped star: its arms reach out while it flashes
          if (time > s.flashAt + 0.6) s.flashAt = time + 3 + Math.random() * 10;
          const flashing = time >= s.flashAt;
          const arm = flashing ? 2 : 1;
          const u = unit;
          ctx.fillStyle = `rgba(${s.color},${flashing ? 1 : alpha})`;
          ctx.fillRect(s.x, s.y, u, u);
          ctx.fillStyle = `rgba(${s.color},${flashing ? 0.85 : alpha * 0.45})`;
          ctx.fillRect(s.x - arm * u, s.y, arm * u, u);
          ctx.fillRect(s.x + u, s.y, arm * u, u);
          ctx.fillRect(s.x, s.y - arm * u, u, arm * u);
          ctx.fillRect(s.x, s.y + u, u, arm * u);
        } else {
          ctx.fillStyle = `rgba(${s.color},${alpha})`;
          ctx.fillRect(s.x, s.y, s.size * unit, s.size * unit);
        }
      }
    };

    let frame = 0, last = 0;
    const tick = (now: number) => {
      if (now - last >= 40) { last = now; draw(now / 1000); }
      frame = requestAnimationFrame(tick);
    };
    const start = () => {
      cancelAnimationFrame(frame);
      setup();
      if (reduceMotion.matches) draw(0);
      else frame = requestAnimationFrame(tick);
    };

    let resizeTimer = 0, lastSize = '';
    const observer = new ResizeObserver(() => {
      const size = `${canvas.clientWidth}x${canvas.clientHeight}`;
      if (size === lastSize) return;
      lastSize = size;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(start, 200);
    });
    observer.observe(canvas);
    reduceMotion.addEventListener('change', start);
    start();
    stoppers.push(() => { cancelAnimationFrame(frame); clearTimeout(resizeTimer); observer.disconnect(); reduceMotion.removeEventListener('change', start); });
  };
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLCanvasElement>('canvas.sky').forEach(startSky));
  document.addEventListener('astro:before-swap', () => { while (stoppers.length) stoppers.pop()!(); });
</script>
